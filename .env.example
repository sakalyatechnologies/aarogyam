# Every setting the server reads, with example values. Nothing here is a real secret.
# Locally, config/local.toml already has working defaults: set a variable only to override it,
# for example in your shell or with `set -a; . ./.env; set +a` after copying this file to .env.
# Deployed services set these as environment variables, with the URLs from Secret Manager.
# A double underscore nests: ARO_DB__URL sets db.url. Misspelt ARO_ variables stop the server.

# Where the server runs: local, staging or production.
ARO_ENVIRONMENT=local

# HTTP listener and limits. Defaults: 0.0.0.0:8080 (what Cloud Run expects), 30 s, 1 MiB.
ARO_HTTP__BIND=127.0.0.1:8080
ARO_HTTP__REQUEST_TIMEOUT_SECS=30
ARO_HTTP__BODY_LIMIT_BYTES=1048576

# The API's login role; row-level security applies to it. A secret outside your machine.
ARO_DB__URL=postgres://aarogyam_api@localhost:5432/aarogyam_dev
# The schema owner, used only by `aarogyam migrate`: your OS user locally (no user name in the
# URL), Supabase's postgres user in the cloud. A secret outside your machine.
ARO_DB__OWNER_URL=postgres://aarogyam_owner@localhost:5432/aarogyam_dev
# The API's pool. Defaults suit Supabase's session pooler: 5 connections at most, 2 kept warm
# (a new one costs several round trips), idle ones replaced after 5 minutes and all after 30,
# a ping before reusing one idle for over a minute, 512 cached statements per connection.
# ARO_DB__MAX_CONNECTIONS=5
# ARO_DB__MIN_CONNECTIONS=2
# ARO_DB__IDLE_TIMEOUT_SECS=300
# ARO_DB__MAX_LIFETIME_SECS=1800
# ARO_DB__PING_AFTER_IDLE_SECS=60
# ARO_DB__STATEMENT_CACHE_CAPACITY=512

# Sign-in. Locally: dev tokens for the seeded people. Deployed: Supabase Auth.
ARO_AUTH__MODE=dev
ARO_AUTH__AUDIENCE=authenticated
# Also accept dev tokens in supabase mode (local only; refused elsewhere).
ARO_AUTH__DEV_TOKENS=true
ARO_AUTH__DEV_ISSUER=aarogyam-dev
ARO_AUTH__DEV_SECRET=local-development-secret-not-for-any-deployed-server
# Supabase mode (staging, production, or locally for real sign-in). The issuer and keys URL
# default to $SUPABASE_URL/auth/v1 and $SUPABASE_URL/auth/v1/.well-known/jwks.json.
# ARO_AUTH__MODE=supabase
# ARO_AUTH__ISSUER=https://<project-ref>.supabase.co/auth/v1
# ARO_AUTH__JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# The Supabase project. The plain SUPABASE_URL and SUPABASE_SECRET_KEY names (as in
# .env.supabase) work too. The secret key is server-only: it creates sign-in accounts for
# invited people (sign-ups are off) and must never reach a browser, an app or a log. Without
# it, invitations still work but the invited person can't sign in until their account exists.
# ARO_SUPABASE__URL=https://<project-ref>.supabase.co
# ARO_SUPABASE__SECRET_KEY=

# Host names: {slug} in the template is replaced with the clinic's slug. A deployed environment
# without a wildcard domain yet can use a literal host with no {slug} in it (see docs/deploy.md).
ARO_HOSTS__PORTAL_HOST_TEMPLATE={slug}.localtest.me
ARO_HOSTS__CONSOLE=console.localtest.me
ARO_HOSTS__APP=app.localtest.me

# The secret the Cloudflare Worker sends; required outside local (at least 32 bytes).
# ARO_HTTP__EDGE_SECRET=
# Header carrying the clinic host from the Worker; the Funnel demo uses x-sakalya-host.
# ARO_HTTP__EDGE_HOST_HEADER=x-forwarded-host

# Outgoing email from the outbox. Without a Resend key, email is recorded as delivered and
# logged by id only. The sender must be on a domain verified with Resend. Links in messages
# point at the clinic's portal: https://{host} by default, http://{host}:5173 locally.
# ARO_EMAIL__RESEND_API_KEY=
# ARO_EMAIL__FROM=Aarogyam <no-reply@aarogyam.example>
ARO_EMAIL__PORTAL_LINK=http://{host}:5173

# Clinics' portal addresses at the edge, made to work by `aarogyam outbox drain` before it sends
# email: off (hosts stay pending), wildcard (already served: local, or a wildcard domain) or
# workers_dev (one Worker per clinic through the Cloudflare API; see docs/deploy.md). The token
# needs only "Workers Scripts: Edit" on the account and is read by the outbox job only.
# The plain CLOUDFLARE_* names from .env.cloudflare work too.
ARO_EDGE__HOSTS=wildcard
# ARO_EDGE__CLOUDFLARE_ACCOUNT_ID=
# ARO_EDGE__CLOUDFLARE_API_TOKEN=
# ARO_EDGE__WORKERS_SUBDOMAIN=spring-snow-130f
# ARO_EDGE__WORKER_NAME_TEMPLATE={slug}-aarogyam
# ARO_EDGE__PORTAL_WORKER=aarogyam-portal

# Patient files: where bytes live (local disk, or a private Supabase Storage bucket, which needs
# SUPABASE_URL and SUPABASE_SECRET_KEY), and the download-link secret (32+ bytes; required
# outside local). Cloud Run's disk is wiped on stop, so deployed environments use supabase.
# ARO_FILES__BACKEND=local
# ARO_FILES__BUCKET=aarogyam-files
# ARO_FILES__DIR=var/attachments
# ARO_FILES__SIGNING_KEY=
# Clinic websites: the CNAME target shown to owners and the free address (placeholders).
# ARO_WEBSITE__SITES_TARGET=sites.aarogyam.example
# ARO_WEBSITE__ADDRESS_TEMPLATE={slug}-site.aarogyam.example

# Requests carrying this token in the x-sakalya-throttle-bypass header skip the request limits:
# the local end-to-end stack (scripts/e2e-stack.sh) sets it, because a suite signs in far more
# often than a person. At least 32 bytes; only from this machine; refused outside local.
# ARO_THROTTLE__BYPASS_TOKEN=

# Where scripts/quality-run.sh writes run summaries for the console's Quality dashboard. Outside
# the patient database on purpose (a GCS bucket or BigQuery dataset once deployed).
# ARO_QUALITY__DIR=var/quality

# Logs: pretty locally; cloud-logging (one JSON object per line) in staging and production.
# The filter uses RUST_LOG syntax: info in staging and production.
ARO_TELEMETRY__FORMAT=pretty
ARO_TELEMETRY__FILTER=debug,hyper=info,sqlx=warn,h2=info

# Not read by the server: database tests (#[sqlx::test]) and the pre-commit hook use it.
DATABASE_URL=postgres://localhost:5432/postgres
