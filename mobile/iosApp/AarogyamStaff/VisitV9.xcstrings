    "v9v.close.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes save as you go. Closing signs them and adds the visit to History."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट्स अपने आप सेव होते हैं। बंद करने पर वे साइन होते हैं और विज़िट हिस्ट्री में जुड़ती है।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट्स आपोआप सेव होतात. बंद केल्यावर त्यावर सही होते आणि भेट हिस्ट्रीमध्ये जोडली जाते."
          }
        }
      }
    },
    "v9v.close.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee is saved with the visit once the server supports it. Until then it stays on this screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुल्क सर्वर के समर्थन के बाद विज़िट के साथ सेव होगा। तब तक वह इसी स्क्रीन पर रहता है।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शुल्क सर्व्हरच्या समर्थनानंतर भेटीसोबत सेव्ह होईल. तोपर्यंत ते याच स्क्रीनवर राहते."
          }
        }
      }
    },
    "v9v.close.procedures_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A treatment could not be saved. The visit is still open; try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक उपचार सेव नहीं हो सका। विज़िट खुली है; फिर कोशिश करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक उपचार सेव्ह झाला नाही. भेट उघडी आहे; पुन्हा प्रयत्न करा."
          }
        }
      }
    },
    "v9v.close.sign_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note could not be signed. The visit is still open; try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट साइन नहीं हो सका। विज़िट खुली है; फिर कोशिश करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोटवर सही होऊ शकली नाही. भेट उघडी आहे; पुन्हा प्रयत्न करा."
          }
        }
      }
    },
