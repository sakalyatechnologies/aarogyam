    "notes.problem.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else changed this note while you were editing. Copy your text, cancel and open it again to see their version."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बदलाव के दौरान किसी और ने यह नोट बदल दिया. अपना टेक्स्ट कॉपी करें, रद्द करें और उनका संस्करण देखने के लिए फिर से खोलें."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही बदल करत असताना दुसऱ्या कोणीतरी ही नोंद बदलली. तुमचा मजकूर कॉपी करा, रद्द करा आणि त्यांची आवृत्ती पाहण्यासाठी पुन्हा उघडा."
          }
        }
      }
    },
