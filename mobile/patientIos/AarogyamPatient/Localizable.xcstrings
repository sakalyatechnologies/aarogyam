    "clinics.ask.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinic address name, like sunrise"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिनिक के पते का नाम, जैसे sunrise"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिनिकच्या पत्त्याचे नाव, उदा. sunrise"
          }
        }
      }
    },
    "clinics.ask.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a clinic to connect the record with your email. They confirm it at the front desk."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिनिक से कहें कि वे आपका रिकॉर्ड आपके ईमेल से जोड़ दें। वे इसे रिसेप्शन पर पक्का करते हैं।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिनिकला तुमचा रेकॉर्ड तुमच्या ईमेलशी जोडायला सांगा. ते रिसेप्शनवर खात्री करतात."
          }
        }
      }
    },
    "clinics.ask.sent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked. If the clinic has your email on file, they'll confirm it soon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध भेज दिया। अगर क्लिनिक के पास आपका ईमेल है, तो वे जल्द पक्का करेंगे।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विनंती पाठवली. क्लिनिकच्या नोंदीत तुमचा ईमेल असेल तर ते लवकरच खात्री करतील."
          }
        }
      }
    },
    "clinics.ask.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No code?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड नहीं है?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड नाही?"
          }
        }
      }
    },
    "clinics.code.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like 7KQ2M-X9D4T"
