          }
        }
      }
    },
    "book.error.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clinic doesn't take bookings in the app yet. Please call them."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह क्लिनिक अभी ऐप में बुकिंग नहीं लेता। कृपया उन्हें फोन करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे क्लिनिक अजून अ‍ॅपमध्ये बुकिंग घेत नाही. कृपया त्यांना फोन करा."
          }
        }
      }
    },
    "book.error.taken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone just took that time. Please pick another."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह समय अभी किसी और ने ले लिया। कृपया दूसरा चुनें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ती वेळ आत्ताच कोणीतरी घेतली. कृपया दुसरी निवडा."
          }
        }
      }
    },
    "book.no_slots": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No free times that day. Try another day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस दिन कोई समय खाली नहीं है। दूसरा दिन चुनें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "त्या दिवशी कोणतीही वेळ मोकळी नाही. दुसरा दिवस निवडा."
          }
        }
      }
    },
