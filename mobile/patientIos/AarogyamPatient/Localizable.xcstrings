    "clinics.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clinic gives you a code (on a QR card or by email). Enter it below to see your appointments, prescriptions and bills here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका क्लिनिक आपको एक कोड देता है (QR कार्ड पर या ईमेल से)। उसे नीचे डालें, फिर यहां अपनी अपॉइंटमेंट, पर्चियां और बिल देखें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे क्लिनिक तुम्हाला एक कोड देते (QR कार्डवर किंवा ईमेलने). तो खाली टाका आणि तुमच्या अपॉइंटमेंट, प्रिस्क्रिप्शन आणि बिले इथे पहा."
          }
        }
      }
    },
