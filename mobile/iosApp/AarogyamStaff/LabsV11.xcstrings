    "lv.remind_all.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One reminder per lab, for the overdue cases on screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर लैब को एक याद-दिलाव, स्क्रीन के देर वाले केस के लिए।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक लॅबला एक आठवण, स्क्रीनवरील उशिराच्या केसांसाठी."
          }
        }
      }
    },
