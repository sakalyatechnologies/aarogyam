    "v9v.notes.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak or type. Tap a tag to change a point's section."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलें या लिखें। किसी बिंदु का हिस्सा बदलने के लिए टैग पर टैप करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बोला किंवा लिहा. मुद्द्याचा भाग बदलण्यासाठी टॅगवर टॅप करा."
          }
