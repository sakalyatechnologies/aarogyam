    "appointments.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द करें"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द करा"
          }
        }
      }
    },
    "appointments.cancel.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't cancel it. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम इसे रद्द नहीं कर पाए। कृपया फिर कोशिश करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्ही ते रद्द करू शकलो नाही. कृपया पुन्हा प्रयत्न करा."
          }
        }
      }
    },
    "appointments.cancel.too_late": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's too close to the visit to cancel in the app. Please call the clinic."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज़िट का समय बहुत पास है, ऐप में रद्द नहीं हो सकता। कृपया क्लिनिक को फोन करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "भेटीची वेळ खूप जवळ आहे, अ‍ॅपमध्ये रद्द करता येत नाही. कृपया क्लिनिकला फोन करा."
          }
        }
      }
    },
    "appointments.none_past": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your past visits will show here."
