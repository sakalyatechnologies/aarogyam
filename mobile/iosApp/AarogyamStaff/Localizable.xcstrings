    "walk_in.consent.care": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrees to treatment and keeping their record"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इलाज और रिकॉर्ड रखने के लिए सहमत"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उपचारांना आणि नोंद ठेवण्यास संमती"
          }
        }
      }
    },
    "walk_in.consent.read": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read aloud: “The clinic keeps your health record to treat you, and may remind you about visits by SMS or WhatsApp. You can withdraw this any time.”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़कर सुनाएं: “इलाज के लिए क्लिनिक आपका हेल्थ रिकॉर्ड रखता है, और विज़िट की याद SMS या WhatsApp पर दिला सकता है. आप यह सहमति कभी भी वापस ले सकते हैं.”"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोठ्याने वाचा: “तुमच्यावर उपचार करण्यासाठी क्लिनिक तुमची आरोग्य नोंद ठेवते, आणि भेटींची आठवण SMS किंवा WhatsApp वर करून देऊ शकते. तुम्ही ही संमती कधीही मागे घेऊ शकता.”"
          }
        }
      }
    },
