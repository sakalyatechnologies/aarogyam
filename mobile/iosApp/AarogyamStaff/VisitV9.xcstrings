    "v9v.close.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign it now, or close the visit without it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी साइन करें, या इसके बिना विज़िट बंद करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आत्ता सही करा, किंवा त्याशिवाय भेट बंद करा."
          }
        }
      }
    },
    "v9v.close.confirm.title": {
      "extractionState": "manual",
      "localizations": {
