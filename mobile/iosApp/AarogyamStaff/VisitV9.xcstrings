    "v9v.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are offline. Notes stay on this screen and save when the connection returns. Signing and closing need a connection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। नोट्स इसी स्क्रीन पर रहते हैं और कनेक्शन लौटने पर सेव होते हैं। साइन और बंद करने के लिए कनेक्शन चाहिए।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ऑफलाइन आहात. नोट्स याच स्क्रीनवर राहतात आणि कनेक्शन परत आल्यावर सेव होतात. सही आणि बंद करण्यासाठी कनेक्शन हवे."
          }
        }
      }
    },
    "v9v.patient": {
      "extractionState": "manual",
