    "p9.consent.withdraw_msg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This records that the patient withdrew consent under notice v%@. Earlier records stay."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह दर्ज होगा कि मरीज़ ने सूचना v%@ के तहत सहमति वापस ली। पुराने रिकॉर्ड रहेंगे।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रुग्णाने सूचना v%@ अंतर्गत संमती मागे घेतली अशी नोंद होईल. जुन्या नोंदी राहतील."
          }
        }
      }
    },
