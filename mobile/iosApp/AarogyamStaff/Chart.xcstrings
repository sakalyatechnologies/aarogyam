        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस क्लिनिक में आपकी भूमिका क्लिनिकल रिकॉर्ड नहीं देख सकती."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या क्लिनिकमध्ये तुमच्या भूमिकेला क्लिनिकल नोंदी पाहता येत नाहीत."
