        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल नहीं खुल सकी। फिर कोशिश करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल उघडता आली नाही. पुन्हा प्रयत्न करा."
          }
        }
      }
    },
