            "value": "Notice"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना"
          }
        }
      }
    },
    "c11.notice.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post as notice"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना के रूप में पोस्ट करें"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना म्हणून पोस्ट करा"
          }
        }
      }
    },
    "c11.pinned.a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned notice"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन की गई सूचना"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन केलेली सूचना"
          }
        }
      }
    },
    "c11.attach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a photo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो भेजें"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो पाठवा"
          }
        }
      }
    },
    "c11.photo.camera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो खींचें"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो काढा"
          }
        }
      }
    },
    "c11.photo.library": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from library"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी से चुनें"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लायब्ररीतून निवडा"
          }
        }
      }
    },
    "c11.photo.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo is over 5 MB and was not sent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोटो 5 MB से बड़ी है, भेजी नहीं गई।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो 5 MB पेक्षा मोठा आहे, पाठवला नाही."
          }
        }
      }
    },
    "c11.photo.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo could not be read."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोटो पढ़ी नहीं जा सकी।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो वाचता आला नाही."
          }
        }
      }
    },
