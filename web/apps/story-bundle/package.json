{
  "name": "@aarogyam/story-bundle",
  "private": true,
  "type": "module",
  "description": "The phone story bundle (design §1.7, §1.12): Present mode and the on-device video, hosted by the iOS and Android apps in a WebView. Static, relative paths, no network.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/story-version.mjs manifest",
    "sync": "vite build && node scripts/story-version.mjs sync",
    "check:sync": "vite build && node scripts/story-version.mjs check",
    "smoke": "vite build && node scripts/smoke.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@aarogyam/api-client": "workspace:*",
    "@aarogyam/app-kit": "workspace:*",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.2"
  }
}
