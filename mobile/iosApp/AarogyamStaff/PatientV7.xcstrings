    "pv.block.needs_visit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned treatments are added inside a visit. Start the visit first."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजनाबद्ध उपचार विज़िट के अंदर जुड़ते हैं। पहले विज़िट शुरू करें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियोजित उपचार भेटीत जोडले जातात. आधी भेट सुरू करा."
          }
        }
      }
    },
    "pv.block.no_chart_mark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This treatment leaves no mark on the chart. Add it inside a visit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस उपचार का चार्ट पर कोई निशान नहीं रहता। इसे विज़िट के अंदर जोड़ें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या उपचाराची चार्टवर खूण राहत नाही. ते भेटीत जोडा."
          }
        }
      }
    },
    "pv.block.no_treatment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a treatment first."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले उपचार चुनें।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आधी उपचार निवडा."
          }
        }
      }
    },
    "pv.block.surface_change": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview: changing the surface of an earlier entry needs server support."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीव्यू: पुरानी प्रविष्टि की सतह बदलने के लिए सर्वर सहायता चाहिए।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीव्ह्यू: जुन्या नोंदीचा पृष्ठभाग बदलण्यासाठी सर्व्हर सहाय्य हवे."
          }
        }
      }
    },
