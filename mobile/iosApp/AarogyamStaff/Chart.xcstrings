    "chart.group_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap more teeth to add them, or a picked tooth to remove it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और दांत जोड़ने के लिए उन पर टैप करें, या चुना हुआ दांत हटाने के लिए उस पर टैप करें."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आणखी दात जोडण्यासाठी त्यावर टॅप करा, किंवा निवडलेला दात काढण्यासाठी त्यावर टॅप करा."
          }
        }
      }
    },
