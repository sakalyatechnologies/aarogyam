{
  "name": "aarogyam-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev:portal": "pnpm --filter @aarogyam/portal dev",
    "dev:console": "pnpm --filter @aarogyam/console dev",
    "dev:site": "pnpm --filter @aarogyam/site dev",
    "dev:website": "pnpm --filter @aarogyam/website dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint web",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
