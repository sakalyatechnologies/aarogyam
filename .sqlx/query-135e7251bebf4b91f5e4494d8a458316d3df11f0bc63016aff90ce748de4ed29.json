  "db_name": "PostgreSQL",
  "query": "select id,\n                  case when status = 'open' and expires_at < now() then 'expired' else status end\n                    as \"status!\",\n                  file_name, row_count, valid_rows, error_rows, rows, errors, result, expires_at\n           from aarogyam.stock_import_previews\n           where token_hash = $1\n           for update",
