    "d9.lookup.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the patient by mobile number"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोबाइल नंबर से मरीज़ खोजें"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोबाइल क्रमांकावरून रुग्ण शोधा"
          }
        }
      }
    },
