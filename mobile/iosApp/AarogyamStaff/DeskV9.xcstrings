    "d9.lookup.not_allowed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front desk tools are not available"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्रंट डेस्क के टूल उपलब्ध नहीं हैं"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्रंट डेस्क साधने उपलब्ध नाहीत"
          }
        }
      }
    },
    "d9.lookup.not_allowed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your role needs patient and appointment access to check people in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेक-इन के लिए आपकी भूमिका को मरीज़ और अपॉइंटमेंट की अनुमति चाहिए।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चेक-इनसाठी तुमच्या भूमिकेला रुग्ण आणि अपॉइंटमेंटची परवानगी हवी."
          }
        }
      }
    },
