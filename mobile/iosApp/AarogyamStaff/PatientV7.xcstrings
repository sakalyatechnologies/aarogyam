    "pv.share.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expiring link with a PIN. The patient can open it without an app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
