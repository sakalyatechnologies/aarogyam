    "dx.pay.balance_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of this bill was just collected. ₹%@ is still due; nothing was recorded."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिल का कुछ हिस्सा अभी लिया गया। ₹%@ अभी बाकी है; कुछ दर्ज नहीं हुआ।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या बिलाचा काही भाग आत्ताच घेतला गेला. ₹%@ अजून बाकी आहे; काहीही नोंदले नाही."
          }
        }
      }
    },
