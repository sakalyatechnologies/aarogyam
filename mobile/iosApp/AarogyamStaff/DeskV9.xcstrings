    "d9.lookup.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the 10-digit number. Everyone on it shows up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "10 अंकों का नंबर लिखें। उस नंबर के सभी लोग दिखेंगे।"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "१० अंकी क्रमांक टाका. त्यावरील सर्वजण दिसतील."
          }
        }
      }
    },
