        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज़िट रिमाइंडर के लिए सहमत"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "भेटीच्या आठवणींना संमती"
          }
        }
      }
    },
