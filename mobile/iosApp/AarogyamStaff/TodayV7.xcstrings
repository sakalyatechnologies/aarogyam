    "t7.welcome.1.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your whole dental clinic in your pocket: chairs, the queue and every patient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पूरा डेंटल क्लिनिक जेब में: चेयर, कतार और हर मरीज़."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे संपूर्ण डेंटल क्लिनिक खिशात: चेअर, रांग आणि प्रत्येक रुग्ण."
          }
        }
      }
    },
    "t7.welcome.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Healthy smiles,\nbeautifully run."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वस्थ मुस्कान,\nसुंदर संचालन."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निरोगी हास्य,\nसुंदर व्यवस्थापन."
          }
        }
      }
    },
    "t7.welcome.2.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Men, women and children, each with their own record, even on a shared family number."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरुष, महिलाएं और बच्चे, हर एक का अपना रिकॉर्ड, एक ही परिवार के नंबर पर भी."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरुष, महिला आणि मुले, प्रत्येकाचे स्वतःचे रेकॉर्ड, एकाच कुटुंबाच्या नंबरवरही."
          }
        }
      }
    },
    "t7.welcome.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every patient,\nevery age."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर मरीज़,\nहर उम्र."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक रुग्ण,\nप्रत्येक वय."
          }
        }
      }
    },
    "t7.welcome.3.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chart, plan, prescribe and bill every treatment in a few taps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्ट, योजना, पर्चा और बिल, हर इलाज कुछ ही टैप में."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्ट, योजना, प्रिस्क्रिप्शन आणि बिल, प्रत्येक उपचार काही टॅपमध्ये."
          }
        }
      }
    },
    "t7.welcome.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From check-up\nto implant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जांच से\nइम्प्लांट तक."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तपासणीपासून\nइम्प्लांटपर्यंत."
          }
        }
      }
    },
